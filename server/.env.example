# ==============================================================================
# Spacia Backend (NestJS) — Environment Configuration Template
# ==============================================================================

PORT=8000
NODE_ENV=development

# Neon PostgreSQL Connection String (Pooler or Direct)
DATABASE_URL=postgresql://placeholder_user:placeholder_pass@ep-placeholder.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Frontend CORS Origin
FRONTEND_URL=http://localhost:3000

# Clerk Authentication (Server Secret & Publishable Key)
CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Redis (Upstash or Local)
REDIS_URL=redis://localhost:6379

# AI Agent & OpenRouter Configuration
AI_PROVIDER=mock                      # "openrouter" in production, "mock" in tests
OPENROUTER_API_KEY=                   # Required if AI_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
AI_MAX_TOOL_ITERATIONS=5
AI_CONTEXT_WINDOW_SIZE=10

