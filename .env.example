# ==============================================================================
# SPACIA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or credentials to source control.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the client/browser bundle.
# Variables without NEXT_PUBLIC_ are STRICTLY server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Exposed to browser)
# ------------------------------------------------------------------------------
# Canonical application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application branding name
NEXT_PUBLIC_APP_NAME=Spacia

# Target API base URL for client calls (optional proxy or gateway)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Default active workspace identifier (for local development/mocking before auth)
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=ws_default_spacia

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY CONFIGURATION (Never exposed to browser bundle)
# ------------------------------------------------------------------------------
# Node runtime environment (development, test, production)
NODE_ENV=development

# Server API / Backend Gateway URL
BACKEND_API_URL=http://localhost:8000

# Server-side API Secret Key for upstream services
BACKEND_API_KEY=your_backend_api_key_here

# Webhook signature verification secret
WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here
